# Скопіюйте цей файл у .env.local і заповніть реальними значеннями.
# .env.local не потрапляє в git.

# Токен бота, отриманий від @BotFather
TELEGRAM_BOT_TOKEN=

# ID чату/групи, куди бот надсилатиме фото та відео від гостей
# (можна дізнатись, написавши боту й перевіривши getUpdates,
# або додавши бота в групу і скориставшись @getidsbot)
TELEGRAM_CHAT_ID=
